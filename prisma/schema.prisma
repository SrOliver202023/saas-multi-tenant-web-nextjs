generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  ADMIN
  MEMBER
  VIEWER
}

model Account {
  accountId    String    @id @map("account_id") @db.Uuid
  email        String    @unique @map("email")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  managedUsers User[]    @relation("account_manages_users")
  ownerUserId  String?   @unique @map("owner_user_id") @db.Uuid
  ownerUser    User?     @relation("user_owns_account", fields: [ownerUserId], references: [userId])

  @@index([createdAt])
  @@map("account")
}

model User {
  userId    String    @id @map("user_id") @db.Uuid
  username  String    @unique @map("username")
  name      String    @map("name")
  password  String    @map("password")
  email     String    @unique @map("email")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  managerAccountId String?  @map("manager_account_id") @db.Uuid
  managerAccount   Account? @relation("account_manages_users", fields: [managerAccountId], references: [accountId])

  ownedAccountId String?  @unique @map("owned_account_id") @db.Uuid
  ownedAccount   Account? @relation("user_owns_account")

  externalAuths ExternalAuth[] @relation("external_auth_user") // relação 1:N

  @@index([createdAt])
  @@map("user")
}

model ExternalAuth {
  id             String    @id @default(cuid())
  provider       String // "google", "github", "microsoft", etc.
  providerUserId String // ID do usuário no provedor (sub do Google)
  accessToken    String?
  refreshToken   String?
  expiresAt      DateTime?
  userId         String    @db.Uuid
  user           User      @relation(fields: [userId], references: [userId], name: "external_auth_user")

  @@unique([provider, providerUserId]) // evita duplicação
}
